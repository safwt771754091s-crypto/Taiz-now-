# Taiz Now — Smart Verification Platform
# On Neon use the POOLED url here (host contains `-pooler`); see DIRECT_URL.
DATABASE_URL="postgresql://taiznow:taiznow_secret@127.0.0.1:5432/taiznow?schema=public"
# Direct (unpooled) url, used ONLY by `prisma migrate` during the build.
# On Neon this is the SAME url without `-pooler`. Optional: leave empty and
# migrations will use DATABASE_URL directly.
DIRECT_URL=""
PORT=12000
AUTH_SECRET="change-me-in-production-please-generate-a-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:12000"
# Public base URL used to build links + OAuth redirects. Set to the live domain.
PLATFORM_URL="https://taiznow.ye"
# Secret for the serverless cron endpoint GET /api/cron/tick (Vercel Cron sends
# it automatically as `Authorization: Bearer <CRON_SECRET>`). Any random string.
CRON_SECRET=""
# ── Sources the collector watches (وكيل الجامع) ────────────────────────────────
# Telegram channels to READ (other people's channels, not your own). Comma-sep.
# Accepts @name, bare name, or a t.me link. Uses Telegram's keyless web preview.
TELEGRAM_SOURCE_CHANNELS=""
# Facebook Pages to READ (ids or slugs). Needs FACEBOOK_READ_TOKEN below.
FACEBOOK_SOURCE_PAGES=""
# A token with pages_read_engagement to read the pages above (read-only use).
FACEBOOK_READ_TOKEN=""
# ── AI engine (optional) ──────────────────────────────────────────────────────
# Priority: Groq → OpenAI → local Ollama → deterministic offline engine.
# Groq is free and needs no credit card: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# OpenAI is used only if Groq is absent.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Local Ollama: fully offline and free, no account. Enable after `ollama serve`.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2:3b"

# ── AI agent autopilot ────────────────────────────────────────────────────────
# Interval (seconds) between autopilot ticks when scripts/autopilot_loop.sh runs.
AUTOPILOT_INTERVAL=180

# ── Social publishing (optional; each channel goes LIVE once its keys are set) ─
# Telegram (already working): create a bot with @BotFather, add it as admin to the channel.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID="@YourChannel"
# X (Twitter): OAuth 2.0 USER token with tweet.read + tweet.write (app-only Bearer cannot post).
X_ACCESS_TOKEN=""
X_BEARER_TOKEN=""
# Facebook: set the App ID/Secret once, then use the "ربط بنقرة واحدة" button
# on /social — it stores a never-expiring Page token in the DB automatically.
# (FACEBOOK_PAGE_ID/ACCESS_TOKEN below are only a manual fallback.)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""
# Instagram: a Business/Creator account linked to the Page. Needs a public image URL.
INSTAGRAM_BUSINESS_ID=""
INSTAGRAM_ACCESS_TOKEN=""
# WhatsApp Cloud API: phone number id + token, and the recipient/canal number.
WHATSAPP_PHONE_ID=""
WHATSAPP_TOKEN=""
# LinkedIn: organization id (or full urn) + token with w_organization_social.
LINKEDIN_ORGANIZATION_ID=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_VERSION="202410"

# Source collectors (الجامع agent). Defaults to Google-News Yemen queries; no key.
# SOURCE_FEEDS="https://example.com/rss,https://other.com/atom.xml"
COLLECTOR_MAX_FEEDS=5
COLLECTOR_SINCE_HOURS=72

# ── Platform identity (هوية المنصة والبريد) ───────────────────────────────────
# Domain used for the platform's official mailboxes (info@ / security@ / ...).
PLATFORM_DOMAIN="taiznow.ye"

# ── Outbound mail (تنبيهات الأمن بالبريد) ─────────────────────────────────────
# Leave unset to keep alerts in the local outbox (no email is actually sent).
# Set these to deliver guardian security alerts for real.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="security@taiznow.ye"

# Optional: forward every HIGH/CRITICAL security alert to a webhook/chat.
SECURITY_WEBHOOK_URL=""

# ── Social publishing credentials (optional) ─────────────────────────────────
# Leave empty to run in safe MOCK mode (posts are recorded locally, no network).
# Fill a provider's keys to enable LIVE publishing for that channel.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""
INSTAGRAM_ACCESS_TOKEN=""
X_API_KEY=""
X_ACCESS_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TOKEN=""
LINKEDIN_ACCESS_TOKEN=""
YOUTUBE_CHANNEL_ID=""
TIKTOK_ACCESS_TOKEN=""

# البريد الاحتياطي الشخصي للمالك (قناة استرجاع)
OWNER_RECOVERY_EMAIL="albyysks@gmail.com"
