// Taiz Now — Smart Verification Platform (منصة التحقق الذكي)
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER // مسؤول — full platform administration
  EDITOR // محرر — content & news management
  FACT_CHECKER // مدقق الحقائق — verify news & claims
  MEDIA_ANALYST // محلل إعلامي — image/video analysis
  GEO_ANALYST // محلل جغرافي — geo & maps verification
  SOCIAL_PUBLISHER // الناشر الاجتماعي — social distribution
  VIEWER // مشاهد — read only
}

enum ReportType {
  NEWS
  IMAGE
  VIDEO
  MESSAGE
  OTHER
}

enum ReportStatus {
  PENDING // جديد
  UNDER_REVIEW // قيد المراجعة
  VERIFIED // تم التحقق
  REJECTED // مرفوض
  DUPLICATE // مكرر
}

enum ContentStatus {
  DRAFT // مسودة
  IN_REVIEW // قيد المراجعة
  VERIFIED // موثق
  PUBLISHED // منشور
  REJECTED // مرفوض
  RETRACTED // مسحوب
}

enum ContentKind {
  NEWS // خبر
  RUMOR // شائعة
  CORRECTION // تصحيح
}

enum Verdict {
  TRUE // صحيح
  MOSTLY_TRUE // صحيح غالباً
  MISLEADING // مضلل
  SUSPICIOUS // مشبوه
  FALSE // غير صحيح
  UNVERIFIED // غير متحقق
}

enum EvidenceType {
  SOURCE // مصدر
  DOCUMENT // وثيقة
  IMAGE // صورة
  VIDEO // فيديو
  GEO // دليل جغرافي
  EXPERT // رأي خبير
}

enum MediaKind {
  IMAGE
  VIDEO
  MESSAGE
}

enum MediaStatus {
  PENDING
  ANALYZED
  REVIEWED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportsAuthored  Report[]           @relation("ReportReporter")
  reportsAssigned  Report[]           @relation("ReportAssignee")
  newsCreated      ContentItem[]      @relation("ContentCreator")
  newsReviewed     ContentItem[]      @relation("ContentReviewer")
  mediaReviewed    MediaAsset[]
  auditLogs        AuditLog[]
  confidenceAudits ConfidenceRecord[]
  recoveryChannels RecoveryChannel[]
  loginEvents      LoginEvent[]
  visits           Visit[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([role, permissionId])
}

model Source {
  id          String   @id @default(cuid())
  name        String
  url         String?
  type        String   @default("media") // media | official | eyewitness | social | archive
  reliability Int      @default(50) // 0-100 baseline trust in the source
  notes       String?
  createdAt   DateTime @default(now())

  evidence Evidence[]
}

model Report {
  id              String       @id @default(cuid())
  type            ReportType   @default(NEWS)
  title           String
  description     String
  mediaUrl        String?
  sourceUrl       String? // original link when collected from an external source
  origin          String? // e.g. "feed:google-news:تعز" | "manual"
  location        String?
  anonymous       Boolean      @default(false)
  reporterName    String?
  reporterContact String?
  status          ReportStatus @default(PENDING)
  priority        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reporterId   String?
  reporter     User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?   @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  media    MediaAsset[]
  evidence Evidence[]

  @@index([status])
  @@index([type])
}

model ContentItem {
  id             String        @id @default(cuid())
  kind           ContentKind
  slug           String        @unique
  title          String
  summary        String
  body           String        @db.Text
  status         ContentStatus @default(DRAFT)
  verdict        Verdict       @default(UNVERIFIED)
  confidence     Int           @default(0)
  claim          String? // the exact claim being checked (for rumors)
  correctionNote String? // what was corrected (for corrections)
  location       String?
  tags           String[]      @default([])
  publishedAt    DateTime?
  lastReviewedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdById  String?
  createdBy    User?   @relation("ContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?   @relation("ContentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  evidence    Evidence[]
  scores      ConfidenceRecord[]
  media       MediaAsset[]
  markers     MapMarker[]
  socialPosts SocialPost[]

  @@index([kind, status])
}

model Evidence {
  id        String       @id @default(cuid())
  type      EvidenceType
  title     String
  url       String?
  note      String?
  weight    Int          @default(0) // contribution to confidence (0-100 signal)
  createdAt DateTime     @default(now())

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  reportId      String?
  report        Report?      @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([reportId])
}

model ConfidenceRecord {
  id           String   @id @default(cuid())
  entityType   String // "ContentItem" | "MediaAsset"
  entityId     String
  sourceScore  Int      @default(0)
  contentScore Int      @default(0)
  imageScore   Int      @default(0)
  videoScore   Int      @default(0)
  contextScore Int      @default(0)
  humanScore   Int      @default(0)
  total        Int      @default(0)
  verdict      Verdict  @default(UNVERIFIED)
  breakdown    Json?
  computedAt   DateTime @default(now())
  computedById String?
  computedBy   User?    @relation(fields: [computedById], references: [id], onDelete: SetNull)

  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model MediaAsset {
  id                     String      @id @default(cuid())
  kind                   MediaKind
  url                    String
  mimeType               String?
  byteSize               Int?
  capturedAt             DateTime?
  gpsLat                 Float?
  gpsLng                 Float?
  device                 String?
  metadata               Json?
  // analysis signals
  aiGeneratedProbability Float? // 0-1, probability the image is AI-generated
  deepfakeProbability    Float? // 0-1, probability the video audio/visual is synthetic
  reverseSearchHits      Int? // number of earlier occurrences found
  geoVerified            Boolean     @default(false)
  analysisNotes          String?
  status                 MediaStatus @default(PENDING)
  createdAt              DateTime    @default(now())

  reportId      String?
  report        Report?      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([contentItemId])
}

model MapMarker {
  id          String   @id @default(cuid())
  label       String
  lat         Float
  lng         Float
  category    String   @default("general") // incident | verified | rumor | correction
  description String?
  confidence  Int      @default(0)
  createdAt   DateTime @default(now())

  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([category])
}

model SocialPost {
  id          String    @id @default(cuid())
  platform    String // facebook | x | instagram | telegram | website
  body        String    @db.Text
  status      String    @default("draft") // draft | scheduled | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([status, scheduledAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

// ─── AI Agents (وكلاء الذكاء الاصطناعي) ──────────────────────────────────────
enum AgentStatus {
  ENABLED // مفعّل
  PAUSED // متوقف مؤقتاً
  DISABLED // معطّل
}

enum AgentKind {
  COLLECTOR // جامع المصادر والأخبار
  MONITOR // راصد المصادر والبلاغات
  VERIFIER // مدقق الحقائق آلياً
  WRITER // الصائغ الاحترافي
  PUBLISHER // الناشر في وسائل التواصل
  RESPONDER // الردّ على الأخبار الكاذبة
  GUARDIAN // حارس المنصة: الصفحات والإعدادات والأمن
}

model Agent {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  role        String
  description String
  kind        AgentKind
  status      AgentStatus @default(ENABLED)
  config      Json?
  runCount    Int         @default(0)
  errorCount  Int         @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  runs AgentRun[]

  @@index([kind])
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  action    String
  status    String   @default("ok") // ok | error
  summary   String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

// ─── Social Media Integrations (وسائل التواصل) ────────────────────────────────
enum ConnectionMode {
  MOCK // محاكاة — النشر يُسجّل محلياً
  LIVE // مباشر — إعدادات حقيقية مهيأة
}

model PlatformIdentity {
  id        String   @id @default(cuid())
  provider  String   @unique // google | facebook | x | instagram | telegram | whatsapp | linkedin | tiktok | youtube
  handle    String?
  email     String?
  connected Boolean  @default(false)
  linkedVia String?
  updatedAt DateTime @updatedAt
}

model SocialConnection {
  id           String         @id @default(cuid())
  provider     String         @unique
  displayName  String
  mode         ConnectionMode @default(MOCK)
  enabled      Boolean        @default(true)
  handle       String?
  accountName  String?
  credentials  Json?
  /** When the stored credential stops working (null = never expires). */
  expiresAt    DateTime?
  lastPostedAt DateTime?
  postCount    Int            @default(0)
  errorCount   Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── Platform branding / email identity (هوية المنصة والبريد) ─────────────────
model PlatformBrand {
  id        String   @id @default("main")
  name      String   @default("تعز الآن")
  nameEn    String   @default("Taiz Now")
  tagline   String   @default("منصة التحقق الذكي")
  slogan    String   @default("لا ننشر ما يُقال... بل نتحقق مما حدث.")
  primary   String   @default("#2dd4bf")
  accent    String   @default("#38bdf8")
  website   String?
  updatedAt DateTime @updatedAt
}

enum EmailKind {
  INFO // عام / info@
  SUPPORT // دعم / support@
  NOREPLY // لا للرد / noreply@
  SECURITY // أمني / security@
}

model PlatformEmailAccount {
  id              String    @id @default(cuid())
  address         String    @unique
  kind            EmailKind @default(INFO)
  displayName     String
  provider        String    @default("google") // google | custom-domain
  linkedVia       String    @default("google")
  verified        Boolean   @default(false)
  usedForLogin    Boolean   @default(false)
  usedForRecovery Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PageKind {
  LANDING
  SECTION
  PLATFORM
  CONTACT
  LEGAL
  OTHER
}

model ManagedPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  route       String   @unique
  kind        PageKind @default(OTHER)
  description String?
  systemRoute Boolean  @default(false) // صفحة كود فعلية — لا تُحذف
  agentBuilt  Boolean  @default(false)
  published   Boolean  @default(true)
  navOrder    Int      @default(0)
  icon        String?
  tags        String[] @default([])
  health      String   @default("ok") // ok | drift | error
  lastChecked DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
}

enum SecurityEventKind {
  CONFIG_DRIFT // تغيّر إعدادات مهمّة
  BRAND_CHANGE // تغيّر الهوية/الشعار
  EMAIL_CHANGE // تغيّر بريد المنصة
  PAGE_CHANGE // تغيّر/حذف صفحة
  ROLE_CHANGE // تغيّر صلاحية مستخدم
  PASSWORD_CHANGE // تغيّر كلمة مرور
  LOGIN_FAILED // محاولة دخول فاشلة
  NEW_DEVICE // دخول من جهاز/موقع جديد
  CONNECTION_CHANGE // تغيّر قناة تواصل
  INTEGRITY_OK // فحص سلامة ناجح
  RECOVERY // استعادة إلى نسخة معتمدة
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityEvent {
  id          String           @id @default(cuid())
  kind        SecurityEventKind
  severity    SecuritySeverity @default(INFO)
  title       String
  detail      Json?
  actorId     String?
  subjectId   String?
  resolved    Boolean          @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([kind])
  @@index([createdAt])
}

model ConfigSnapshot {
  id         String   @id @default(cuid())
  scope      String   @default("platform")
  hash       String
  payload    Json
  approvedBy String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([scope, createdAt])
}

// ─── Security alerting & account recovery (تنبيهات الأمن وقناة الاسترجاع) ──────
enum AlertChannel {
  EMAIL
  WEBHOOK
  INBOX
}

enum AlertDelivery {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model SecurityAlert {
  id             String          @id @default(cuid())
  channel        AlertChannel
  recipient      String
  subject        String
  body           String
  severity       SecuritySeverity @default(INFO)
  status         AlertDelivery   @default(PENDING)
  error          String?
  securityEventId String?
  createdAt      DateTime        @default(now())
  sentAt         DateTime?

  @@index([status])
  @@index([createdAt])
}

enum RecoveryChannelKind {
  BACKUP_EMAIL
  PHONE
  TOTP
}

model RecoveryChannel {
  id          String               @id @default(cuid())
  kind        RecoveryChannelKind
  label       String
  value       String // البريد الاحتياطي أو الرقم (يُخزّن مختصراً/masked في الواجهة)
  userId      String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  verified    Boolean              @default(false)
  primary     Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
}

model LoginEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  ok         Boolean
  ip         String?
  userAgent  String?
  fingerprint String? // ip+ua hash — للكشف عن جهاز/موقع جديد
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([fingerprint])
}

/// Every page view on the public site — the owner's "who visited" ledger.
model Visit {
  id        String   @id @default(cuid())
  path      String
  referer   String?
  ip        String?
  userAgent String?
  country   String? // from an edge geo header when present (Vercel)
  city      String?
  isBot     Boolean  @default(false)
  visitorId String? // hashed ip+ua, distinct-visitor counting; no raw id stored
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
}
